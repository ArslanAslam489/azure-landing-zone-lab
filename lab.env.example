# copy to ~/azlab.env; never commit the real file
export SUB=<subscription-id>
export TENANT_ID=<tenant-id>
export LOC=swedencentral LOC2=northeurope
# Level 3
export SQL=<sql-server-name-without-.database.windows.net>
export SQLPASS='<sql-admin-password>'
export ACR=<acr-name>
export AKS=<aks-cluster-name>
k() { az aks command invoke -g rg-lab-aks -n "$AKS" --command "$1" ${2:+--file $2} --query logs -o tsv; }
